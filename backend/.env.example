# CodeLens Backend Configuration

# Server Port
PORT=3000

# Google Gemini API Key (Required)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_KEY=your_gemini_api_key_here

# Optional: Alternatively you can use GEMINI_API_KEY
# GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name (Optional, defaults to gemini-3.5-flash)
# Supported options: gemini-3.5-flash, gemini-3.6-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash
